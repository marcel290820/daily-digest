# Copy to /etc/daily-digest/env on the VM (mode 0600, owned by the service user).
# For local dev: `cp .env.example .env` and `source .env` before running.

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
TELEGRAM_CHAT_ID=123456789

# Services the system report checks: comma-separated, without ".service".
# Unset, the report flags that no services were checked.
SYSTEM_SERVICES=ssh,cron

# Fear & Greed history database. Optional: the systemd unit already sets
# /var/lib/daily-digest/feargreed.db, and local runs default to ./feargreed.db.
#DIGEST_DB_PATH=/var/lib/daily-digest/feargreed.db

# Optional: ISO birth date for the "life lived" line atop the tech digest.
#BIRTH_DATE=1990-01-31
